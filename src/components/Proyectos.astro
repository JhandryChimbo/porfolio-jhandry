---
import Github from "./icons/Github.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Express from "./icons/Express.astro";
import Flutter from "./icons/Flutter.astro";
import WebSite from "./icons/WebSite.astro";
import Python from "./icons/Python.astro"
import Html from "./icons/Html.astro"
import LinkButton from "./LinkButton.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },

  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#003159] text-white",
    icon: Flutter,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-black text-white",
    icon: Express,
  },
  PYTHON: {
    name: "Python",
    class: "bg-black text-white",
    icon: Python,
  },
  HTML: {
    name: "HTML",
    class: "bg-orange-400 text-white",
    icon: Html,
  },

};

const PROYECTOS = [
  {
    title: "Mobile App for Blood Pressure Control",
    description:
    "A clinical diagnostic web platform that predicts cardiovascular risk using advanced Machine Learning (XGBoost) and a FastAPI backend.",    link: "https://web-cardiovascular.vercel.app/",
    download: null,
    github: "https://github.com/JhandryChimbo/Web_Cardiovascular.git",
    image: "/proyectos/CardioWeb.webp",
    tags: [TAGS.PYTHON, TAGS.HTML],
  },
  {
    title: "Mobile App for Blood Pressure Control",
    description:
    "Android mobile application that allows you to keep track of each patient's blood pressure, as well as provide the necessary dosage for each type.",    link: null,
    download: "https://github.com/JhandryChimbo/PreasureCare/releases/download/v1.0.0/app-release.apk",
    github: "https://github.com/JhandryChimbo/PreasureCare.git",
    image: "/proyectos/PressureCare.webp",
    tags: [TAGS.EXPRESS, TAGS.FLUTTER],
  }
];
---

<div class="flex flex-col gap-y-16">
  {
    PROYECTOS.map(({ image, title, description, tags, link, github, download }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img alt="Monitor" class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-105 md:group-hover:scale-100" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <Github class="size-6" />
              Code
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <WebSite class="size-4" />
              Preview
            </LinkButton>
          )}
          {download && (
            <LinkButton href={download}>
              <WebSite class="size-4" />
              Download
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>
