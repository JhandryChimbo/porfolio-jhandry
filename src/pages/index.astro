---
import Layout from "../layouts/Layout.astro";
import AboutMe from "../components/AboutMe.astro";
import Badge from "../components/Badge.astro";
import BriefIcon from "../components/icons/Brief.astro";
import CodeIcon from "../components/icons/Code.astro";
import CorreoIcon from "../components/icons/Correo.astro";
import Experience from "../components/Experience.astro";
import GithubIcon from "../components/icons/Github.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import Profile from "@/components/icons/Profile.astro";
import Proyectos from "../components/Proyectos.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SocialPill from "../components/SocialPill.astro";
import Workana from "@/components/icons/Workana.astro";
import Hero from "@/components/Hero.astro";
---

<Layout
  title="Jhandry Chimbo - Software Developer & Data Analyst"
  description="Hire Jhandry to build modern websites, applications, and data solutions. Specialized software developer delivering robust web solutions and data-driven insights through advanced data analysis and machine learning."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
  </main>
  <div class="space-y-24">
    <SectionContainer id="Experience">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
      >
        <BriefIcon class="size-8" />
        Work Experience 
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
      >
        <CodeIcon class="size-7" />
        Projects
      </h2>
      <Proyectos />
    </SectionContainer>

    <SectionContainer id="about-me">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
      >
        <Profile class="size-8" />
        About Me
      </h2>
      <AboutMe />
    </SectionContainer>
  </div>
</Layout>
