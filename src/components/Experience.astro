---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "February 2024 - March 2025",
    title: "Technician Assistant at Acofit | Accounting Firm",
    description:
      "Responsible for process automation, creating automated tasks for generating certificates, preparing reports, and modifying documents. Additionally, I provided technical support and guidance to the team, assisting with the use of tools like Microsoft Word and Excel. I also collaborated on designing presentations, documents, and cards.",
    link: undefined,
  },
  // {
  //   date: "March 2022",
  //   title: "Marketing UI design in Figma",
  //   description:
  //     "All of the pages and components are first designed in Figma and we keep a parity between the two versions even as we update the project.",
  // },
  // {
  //   date: "April 2022",
  //   title: "E-Commerce UI code in Tailwind CSS",
  //   description:
  //     "Get started with dozens of web components and interactive elements built on top of Tailwind CSS.",
  // },
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem date={experience.date} title={experience.title} description={experience.description} link={experience.link} />
      </li>
    ))
  }
</ol>
